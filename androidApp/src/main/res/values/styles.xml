<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="H1" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">@font/jamsil_thickness3</item>
        <item name="android:fontFamily">@font/jamsil_thickness3</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/apple_text_primary</item>
    </style>

    <style name="B1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/jamsil_thickness2</item>
        <item name="android:fontFamily">@font/jamsil_thickness2</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">@color/apple_text_primary</item>
    </style>

    <style name="B2" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/jamsil_thickness2</item>
        <item name="android:fontFamily">@font/jamsil_thickness2</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/apple_text_secondary</item>
    </style>

    <style name="AppleButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary_apple</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="AppleButtonSecondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_secondary_apple</item>
        <item name="android:textColor">@color/apple_text_primary</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

</resources>
